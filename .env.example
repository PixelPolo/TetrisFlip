# Copy to .env (git-ignored) for local development. Never commit real secrets.
# Generate each password with: openssl rand -hex 24   (hex only: it ends up inside a URI)
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
MONGO_APP_USER=tetrisflip

# Local only: also load docker-compose.local.yml (publishes http://localhost:8080 on this machine).
# Do NOT set this on Coolify, which must route through its own proxy.
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
